# MEXC API Configuration
MEXC_API_KEY=your_api_key_here
MEXC_SECRET_KEY=your_secret_key_here

# Mode: true=dry-run (no real orders), false=live trading
DRY_RUN=true

# Trading Configuration
LEVERAGE=200
TRADE_AMOUNT_USDT=100
MAX_POSITION_SIZE=1000
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=3.0

# Strategy Settings
PRICE_DEVIATION_THRESHOLD=0.00005
CHECK_INTERVAL_SECONDS=5

# Order Settings
ORDER_TYPE=maker
ORDER_EXPIRY_SECONDS=30

# Telegram Notifications (optional)
# 1. Talk to @BotFather on Telegram to create a bot and get token
# 2. Talk to @userinfobot to get your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
